[Unit]
Description=mqtt-raspberry-controller
Documentation=https://github.com/AC-CodeProd/mqtt-raspberry-controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mqtt-raspberry-controller
Group=mqtt-raspberry-controller
SupplementaryGroups=gpio
LoadCredential=mqtt-password:/etc/mqtt-raspberry-controller/mqtt-password
Environment=MQTT_PASSWORD_FILE=%d/mqtt-password
ExecStart=/usr/local/bin/mqtt-raspberry-controller --config /etc/mqtt-raspberry-controller/config.yaml
Restart=on-failure
RestartSec=5s

# The daemon and its configured child processes run without privilege escalation.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Keep the host filesystem immutable; configured actions may use their private /tmp.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
UMask=0077
StateDirectory=mqtt-raspberry-controller
StateDirectoryMode=0700

# Do not use PrivateDevices: the daemon needs the real GPIO character device.
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw

ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
KeyringMode=private
RemoveIPC=yes

MemoryMax=128M
TasksMax=64
KillMode=control-group
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
